{
  "name": "clinic-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Physiotherapy clinic management: patients, sittings, payments, expenses, reports, users & roles, WhatsApp messaging.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:import-legacy": "tsx scripts/import-legacy.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:import-legacy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9"
  }
